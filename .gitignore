.env
.cursor/
.scratch/
*.tex
*.bib
*.cls
*.bst

__pycache__/
*.py[cod]
.pytest_cache/

# Raw run artifacts can contain provider metadata and are too large for the repo.
runs/**/requests.jsonl
runs/**/responses.jsonl
runs/**/parsed.jsonl
runs/**/steps.jsonl
runs/**/*.before-*.jsonl
# The review artifact's adaptive steps are stripped of provider metadata by the export.
!runs/review-artifact/**/steps.jsonl
